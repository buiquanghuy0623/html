/* Bước 7: Định dạng tiêu đề truyện (font chữ, kích thước, màu sắc và căn giữa) */
h1 {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 28px;
    color: #2c3e50;
    text-align: center;
    margin-bottom: 20px;
}

/* Định dạng hình ảnh đầu trang (Bước 4) */
.story-banner {
    display: block;
    margin: 0 auto 20px auto;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

/* Bước 8: Định dạng khối mục lục (khung viền, màu nền, khoảng đệm) */
.toc-container {
    background-color: #f8f9fa;
    border: 1px solid #dcdde1;
    padding: 15px 20px;
    border-radius: 6px;
    margin-bottom: 30px;
}

.toc-container h3 {
    margin-top: 0;
    color: #2c3e50;
}

.toc-container ul {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 0;
}

.toc-container li {
    margin: 8px 0;
}

/* Bước 5 & 8: Thẻ h5 cho mục lục và hiệu ứng hover cho liên kết */
.toc-container h5 {
    display: inline;
    font-size: 16px;
    margin: 0;
}

.toc-container a {
    color: #2980b9;
    text-decoration: none;
    transition: color 0.2s ease;
}

/* Hiệu ứng hover khi rê chuột vào mục lục */
.toc-container a:hover {
    color: #e74c3c;
    text-decoration: underline;
}

/* Định dạng phần nội dung các chương truyện */
.chapter {
    margin-bottom: 40px;
    padding-top: 10px;
}

.chapter h2 {
    color: #34495e;
    border-bottom: 2px solid #ecf0f1;
    padding-bottom: 5px;
}

/* Bước 9: Canh lề và giãn dòng cho các đoạn văn bản thân truyện */
.chapter p {
    font-family: Arial, sans-serif;
    font-size: 16px;
    color: #333333;
    line-height: 1.8;          /* Giãn dòng */
    text-align: justify;       /* Canh đều hai bên */
    text-indent: 30px;         /* Thụt lề dòng đầu */
    margin-bottom: 15px;
}

/* Định dạng tổng thể trang web */
body {
    max-width: 800px;
    margin: 30px auto;
    padding: 20px;
    background-color: #ffffff;
}
